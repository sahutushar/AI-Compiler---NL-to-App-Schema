# Multiple Groq keys for auto-rotation on rate limit
# Get free keys at: https://console.groq.com (no credit card required)
# Separate multiple keys with commas
GROQ_API_KEYS=gsk_key1here,gsk_key2here,gsk_key3here,gsk_key4here

# Maximum repair attempts per pipeline run (default: 3)
MAX_REPAIR_ATTEMPTS=3
